# Copy to .env and adjust before deploying
SECRET_KEY=replace-with-a-long-random-string
DEBUG=1
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=electromart_db

# ------------------------------------------------------------------- email
# accounts/mailer.py (Viec 10 - CV59). Loaded by electromart/env.py.
# Leave EMAIL_HOST_USER/EMAIL_HOST_PASSWORD empty to print emails to the
# terminal instead of sending them; fill BOTH in to switch on real delivery.
#
# Gmail: turn on 2-Step Verification, then create an App password at
#   https://myaccount.google.com/apppasswords
# and paste the 16 characters below (spaces are stripped automatically).
# Verify with:  python Backend/manage.py sendtestmail you@gmail.com
SITE_BASE_URL=http://127.0.0.1:8000
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Leave blank to send as EMAIL_HOST_USER (Gmail rejects any other sender).
DEFAULT_FROM_EMAIL=
