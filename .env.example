# Copy to .env and adjust before deploying
SECRET_KEY=replace-with-a-long-random-string
DEBUG=1
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=electromart_db

# Email (accounts/mailer.py, Viec 10 - CV59). Leave EMAIL_HOST_USER/PASSWORD
# empty to just print emails to the terminal instead of sending them.
SITE_BASE_URL=http://127.0.0.1:8000
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
# Use a Gmail "App password", not your normal Gmail password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ElectroMart <no-reply@electromart.vn>
